#!/usr/bin/env bash
#
# Devbin's own release.ci.query (issue 0223): the verdict of the Tests
# workflow's runs on a commit, read through gh.
#
# THIS IS NOT A COMMAND HANDLER: `cmd/.lib/` is skipped by the glob that finds
# commands, so this is a script config points at, as shell-gate is.
#
# THE CONTRACT IS THE RELEASE CORE'S (lib/release.steps, release_ci_verdict):
# run as `ci-state <OWNER/NAME> <sha>`, config naming the repository as
# release.repo does, with no stdin, and one line out, `<verdict><TAB><detail>`,
# the verdict green, failed, pending, none or unknown. The core asks it twice
# in a cut: at pre-flight, under ci.base, about the base commit with no tag in
# DEVBIN_RELEASE_TAG, and at the ci step about the release commit with the
# release tag there.
#
# WITH A TAG, ONLY THAT TAG'S RUNS COUNT, `none` until one exists (issue 0149):
# the tag's run carries the legs a branch push skips.
#
# WITHOUT ONE, a sha with no run of its own is read on the commit before it,
# while each commit between changes only what the workflow's paths-ignore names.
# A push that moves only coordination state starts no run (issue 0110), so a
# release's base is often a board commit, and CI's run on the commit before it
# read exactly the files that commit holds. paths-ignore is read from the
# workflow, its one statement, and an entry that is not a directory's whole
# tree (`<dir>/**`) is unknown rather than read as something else. A run on the
# coordination commit itself, from a push that carried code with it, is that
# commit's verdict, and the walk stops there.
#
# A RUN'S VERDICT IS ITS TEST SUMMARY JOB'S, not the run's conclusion: the
# workflow's WSL leg blocks nothing and Test Summary does not wait for it
# (docs/releasing.md), so a red WSL job turns a tag's run red while its verdict
# is green. A summary that is absent, skipped, cancelled or still going is not
# green: a finished run with none is failed, naming that. AMONG SEVERAL
# RUNS ON ONE SHA the worst decides: failed (any conclusion but success, a
# cancelled one included) over one still going over green. ci-state.bats holds
# SUMMARY to the job's name in the workflow.
#
set -euo pipefail

WORKFLOW=.github/workflows/tests.yml
SUMMARY="Test Summary"

if [ "$#" -ne 2 ]; then
  printf 'usage: ci-state <OWNER/NAME> <sha>\n' >&2
  exit 2
fi
repo="$1"
sha="$2"
tag="${DEVBIN_RELEASE_TAG:-}"
export GH_PROMPT_DISABLED=1

# runs_on <sha> -- the Tests runs gh lists on <sha>, one
# `<id><TAB><headBranch><TAB><status><TAB><conclusion>` a line. The conclusion
# is last because it is empty while a run is going, and read splits a run of
# tabs as one.
runs_on() {
  gh run list --repo "$repo" --workflow "${WORKFLOW##*/}" --commit "$1" \
    --json databaseId,headBranch,status,conclusion \
    --jq '.[] | [(.databaseId | tostring), .headBranch, .status, .conclusion] | @tsv'
}

# summary_of <id> -- `<status><TAB><conclusion>` of run <id>'s SUMMARY job,
# nothing when it has none.
summary_of() {
  gh run view "$1" --repo "$repo" --json jobs \
    --jq '.jobs[] | select(.name == "'"$SUMMARY"'") | [.status, .conclusion] | @tsv'
}

# verdict_of <runs> -- the verdict line for <runs>, counting only the tag's
# when there is one; nothing when no run counts. Exits 1, gh's words on
# stderr, when a run's jobs cannot be read.
verdict_of() {
  local id ref st con r v job by rank=0 best=""
  while IFS=$'\t' read -r id ref st con; do
    [ -n "$id" ] || continue
    [ -z "$tag" ] || [ "$ref" = "$tag" ] || continue
    job="$(summary_of "$id")" || return 1
    by=""
    if [ -n "$job" ]; then
      IFS=$'\t' read -r st con <<<"$job"
      by="$SUMMARY: "
    elif [ "$st" = completed ]; then
      # A finished run with no summary job never reached the verdict.
      con="no $SUMMARY job"
    fi
    if [ "$st" != completed ]; then
      r=2
      v="$(printf 'pending\trun %s (%s%s)' "$id" "$by" "$st")"
    elif [ "$con" = success ]; then
      r=1
      v="$(printf 'green\trun %s' "$id")"
    else
      r=3
      v="$(printf 'failed\trun %s (%s%s)' "$id" "$by" "${con:-no conclusion}")"
    fi
    if [ "$r" -gt "$rank" ]; then
      rank="$r"
      best="$v"
    fi
  done <<<"$1"
  printf '%s' "$best"
}

# ignored_prefixes -- each paths-ignore entry of the workflow as the directory
# it ignores, `intent/whiteboard/` for `'intent/whiteboard/**'`, one a line;
# exits 1 naming an entry of any other shape.
ignored_prefixes() {
  local entries e found=""
  entries="$(awk '
    /^ *paths-ignore:/ { f = 1; next }
    f && /^ *- / { v = $0; sub(/^ *- */, "", v); gsub(/["'\'']/, "", v); print v; next }
    f { f = 0 }
  ' "$WORKFLOW")"
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    case "$e" in
      */\*\*) found+="${e%\*\*}"$'\n' ;;
      *)
        printf "%s's paths-ignore entry '%s' is not a directory's whole tree (<dir>/**), which is all this query reads" "$WORKFLOW" "$e"
        return 1
        ;;
    esac
  done <<<"$entries"
  printf '%s' "$found"
}

# only_ignored <commit> <parent> <prefixes> -- true when every path <commit>
# changes from <parent> is under one of <prefixes>.
only_ignored() {
  local p q hit changed
  changed="$(git diff --name-only --no-renames "$2" "$1")"
  [ -n "$changed" ] || return 1
  while IFS= read -r p; do
    hit=no
    while IFS= read -r q; do
      [ -n "$q" ] || continue
      case "$p" in "$q"*) hit=yes ;; esac
    done <<<"$3"
    [ "$hit" = yes ] || return 1
  done <<<"$changed"
}

c="$sha"
prefixes=""
read_prefixes=no
err="$(mktemp "${TMPDIR:-/tmp}/ci-state.XXXXXX")"
trap 'rm -f "$err"' EXIT
while :; do
  if ! out="$(runs_on "$c" 2>"$err")"; then
    printf 'unknown\tgh run list failed for %s: %s\n' "${c:0:12}" "$(head -n 1 "$err")"
    exit 0
  fi
  if ! v="$(verdict_of "$out" 2>"$err")"; then
    printf 'unknown\tgh run view failed for %s: %s\n' "${c:0:12}" "$(head -n 1 "$err")"
    exit 0
  fi
  if [ -n "$v" ]; then
    if [ "$c" = "$sha" ]; then
      printf '%s\n' "$v"
    else
      printf '%s, on %s: the commits after it to %s change only %s, which the Tests workflow ignores\n' \
        "$v" "${c:0:12}" "${sha:0:12}" "${prefixes//$'\n'/, }"
    fi
    exit 0
  fi
  if [ -n "$tag" ]; then
    printf 'none\tno Tests run for %s on %s yet\n' "$tag" "${sha:0:12}"
    exit 0
  fi
  if [ "$read_prefixes" = no ]; then
    if ! prefixes="$(ignored_prefixes)"; then
      printf 'unknown\t%s\n' "$prefixes"
      exit 0
    fi
    read_prefixes=yes
  fi
  parent="$(git rev-parse -q --verify "$c^1")" || break
  only_ignored "$c" "$parent" "$prefixes" || break
  c="$parent"
done
if [ "$c" = "$sha" ]; then
  printf 'none\tno Tests run on %s\n' "${sha:0:12}"
else
  printf 'none\tno Tests run on %s, nor on the commits before it to %s, the last that changes what the workflow reads\n' "${sha:0:12}" "${c:0:12}"
fi
