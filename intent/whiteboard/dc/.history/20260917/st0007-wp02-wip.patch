+# mktemp_beside <file> -- a temporary that will REPLACE <file>, on stdout.
+#
+# THE ONE HOME FOR "write a temporary, then rename it over the file", which had
+# a copy in every writer that replaced a file. Two things are true of the
+# temporary it makes, and each copy had got one of them wrong:
+#
+# - IT IS BESIDE THE FILE, NOT IN TMPDIR. A rename is atomic only within one
+#   filesystem; across two, `mv` quietly copies, and a kill mid-copy leaves the
+#   truncated file this pattern exists to rule out (issue 0002).
+# - IT HAS THE FILE'S MODE. mktemp creates 0600, and the rename carries that
+#   onto the file, so every writer that renamed a temporary into place left a
+#   0644 file 0600 -- CHANGELOG.md and RELEASES.md were, on the machine that
+#   generated them, with nothing to show it, since git records only the
+#   executable bit. `cp -p` gives the temporary the file's mode; a writer's `>`
+#   into it truncates and keeps that mode. A file that does not exist yet gets
+#   the mode the umask gives a new file.
+mktemp_beside() {
+  local file="$1" tmp
+  tmp="$(mktemp "${file}.XXXXXX")" || return 1
+  if [ -e "$file" ]; then
+    cp -p "$file" "$tmp" || {
+      rm -f "$tmp"
+      return 1
+    }
+  else
+    chmod "$(printf '%o' "$((0666 & ~$(umask)))")" "$tmp" || {
+      rm -f "$tmp"
+      return 1
+    }
+  fi
+  printf '%s\n' "$tmp"
+}
+
 # sed_inplace <expression> <file> -- edit a file in place, portably.
 #
 # `sed -i` is not portable: BSD sed (macOS) requires an argument to -i and GNU
 # sed (Linux CI) refuses one. The corpus wrote `sed -i ''`, which is correct on
 # a Mac and fails on Ubuntu. Writing through a temporary and renaming sidesteps
 # the divergence and is atomic besides, which matters when the file being
-# rewritten is the project's version.
+# rewritten is the project's version. The rename's own status is the answer too:
+# a replace that did not happen is not an edit that did.
 sed_inplace() {
   local expr="$1" file="$2" tmp
-  tmp="$(mktemp "${file}.XXXXXX")" || return 1
-  if sed "$expr" "$file" >"$tmp"; then
-    mv "$tmp" "$file"
+  tmp="$(mktemp_beside "$file")" || return 1
+  if sed "$expr" "$file" >"$tmp" && mv "$tmp" "$file"; then
     return 0
   fi
   rm -f "$tmp"
@@ -1046,15 +1079,15 @@ generated_doc_write() {
 
   # R3 -- ATOMIC REPLACE. The temp is created BESIDE THE TARGET, not in TMPDIR:
   # rename is atomic only within a filesystem, so a temp under /tmp renaming
-  # onto a project path can fail cross-device. sed_inplace above already learned
-  # this; the pattern is shared deliberately.
+  # onto a project path can fail cross-device. mktemp_beside above is the one
+  # home for that, and it also gives the temp the target's mode.
   #
   # What this gives and does NOT give: the reader sees the old file or the new
   # one and never a half-written one. It is not a durability guarantee -- shell
   # has no portable fsync, so a machine losing power at the wrong moment may
   # have neither. Atomicity is the property that matters here, and claiming the
   # other one would be the wrong kind of confident.
-  if ! tmp="$(mktemp "${target}.XXXXXX")"; then
+  if ! tmp="$(mktemp_beside "$target")"; then
     warn "generated_doc_write: could not create a temporary file beside $target -- untouched"
