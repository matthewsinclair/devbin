-  local out line verdict
+  local out line verdict rc=0
   out="$(_notes_command_out views-check "$1")" || return 1
+  _notes_command_views_answer views-check "$out" || rc=$?
+  case "$rc" in
+    2) return 0 ;;
+    1) return 1 ;;
+  esac
