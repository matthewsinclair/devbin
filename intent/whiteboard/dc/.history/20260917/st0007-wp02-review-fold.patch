-  local out
+  local out rc=0
   out="$(_notes_command_out views "$1")" || return 1
+  _notes_command_views_answer views "$out" || rc=$?
+  case "$rc" in
+    2) return 0 ;;
+    1) return 1 ;;
+  esac
   _notes_command_paths_ok views "$out" || return 1
   _notes_lines "$out"
