+# _notes_command_views_answer <verb> <out> -- views and views-check always answer:
+# `none` when the project generates no views, and `none` is the whole answer.
+#
+# SILENCE IS NOT AN ANSWER. A notes.run with no views arm printed nothing and
+# exited 0, which read as "generates no views", so `release check` passed over a
+# hand-edited view it never compared (ST0007 WP-02 review, K2) -- an unbuilt
+# step that exited 0 reading as a step that ran. Returns 0 on an answer to go on
+# reading, 2 on `none`, and 1 on a refusal.
+_notes_command_views_answer() {
+  if ! [[ "$2" =~ [^[:space:]] ]]; then
+    warn "release notes: notes.run $1 printed nothing -- a project with no views answers none"
+    return 1
+  fi
+  if [ "${2%$'\n'}" = none ]; then
+    return 2
+  fi
+  if grep -qx none <<<"$2"; then
+    warn "release notes: notes.run $1 printed none beside other lines -- none is the whole answer"
+    return 1
+  fi
+  return 0
