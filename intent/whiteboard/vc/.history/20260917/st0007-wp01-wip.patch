diff --git a/lib/cmd/release b/lib/cmd/release
new file mode 100755
index 0000000..eafc62b
--- /dev/null
+++ b/lib/cmd/release
@@ -0,0 +1,190 @@
+#!/usr/bin/env bash
+#
+# The built-in `release` (ST0007): one copy of the release sequence for every
+# project that releases. Opt-in, like `publish` (design D35): a project enables
+# it with `commands.release.enabled: true`, and a `release:` block does not
+# enable it by being present.
+#
+#   release <--patch|--minor|--major|vX.Y.Z> [--dry-run] [--yes]   cut a release
+#   release status <vX.Y.Z>                                         the resume map
+#   release notes                                                   regenerate the notes views
+#   release check                                                   the declaration, and the notes views
+#   release                                                         usage, exit 1
+#
+# EVERY ARGUMENT IS PARSED BEFORE ANYTHING ACTS, and `-h` or `--help` in any
+# position prints usage and exits 0 (D36). Issue 0064 recorded
+# `macos prepare --help` rebuilding Intent.app: a handler that acts on its
+# first word before reading the rest cannot promise that --help is safe.
+#
+# AS BUILT BY WP-01: the argument loop and `release check`'s declaration half.
+# A well-formed cut, `status` and `notes` parse and then exit 3 naming the work
+# package that builds them, and `check` says its notes half is not examined. An
+# unbuilt step that exited 0 would read as a step that ran.
+#
+set -euo pipefail
+
+# shellcheck source=lib/helpers
+. "${DEVBIN_LIB:?run me through bin/devbin}/helpers"
+# shellcheck source=lib/config
+. "$DEVBIN_LIB/config"
+
+usage() {
+  local me="${DEVBIN_INVOKE:-bin/devbin} release"
+  printf 'usage: %s <--patch|--minor|--major|vX.Y.Z> [--dry-run] [--yes]\n' "$me"
+  printf '       %s status <vX.Y.Z>\n' "$me"
+  printf '       %s notes\n' "$me"
+  printf '       %s check\n\n' "$me"
+  printf '  Cut a release: stamp, commit, gate, tag, push, and the release object,\n'
+  printf '  each step checked first so a re-run continues. Declared in the release:\n'
+  printf '  block of bin/.devbin/config.yaml; see docs/configuration.md.\n'
+}
+
+# refuse <message> -- a usage refusal: usage on stderr, the reason, exit 1.
+refuse() {
+  usage >&2
+  printf '\n' >&2
+  die "release: $1"
+}
+
+# --help first, over every argument, so no later word can act or refuse first.
+for arg in "$@"; do
+  case "$arg" in
+    -h | --help)
+      usage
+      exit 0
+      ;;
+  esac
+done
+
+if [ $# -eq 0 ]; then
+  usage >&2
+  exit 1
+fi
+
+# --- parse ----------------------------------------------------------------
+verb=cut
+target=""
+version=""
+dry_run=0
+assume_yes=0
+
+case "$1" in
+  status | notes | check)
+    verb="$1"
+    shift
+    ;;
+esac
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --patch | --minor | --major)
+      [ "$verb" = cut ] || refuse "$1 is a cut's target, and this is release $verb"
+      [ -z "$target" ] || refuse "one target only, got $target and $1"
+      target="$1"
+      ;;
+    --dry-run)
+      [ "$verb" = cut ] || refuse "--dry-run applies to a cut, not to release $verb"
+      dry_run=1
+      ;;
+    --yes)
+      [ "$verb" = cut ] || refuse "--yes applies to a cut, not to release $verb"
+      assume_yes=1
+      ;;
+    -*)
+      refuse "unknown argument: $1"
+      ;;
+    *)
+      case "$verb" in
+        cut)
+          [ -z "$target" ] || refuse "one target only, got $target and $1"
+          is_semver "${1#v}" || refuse "not a version: $1 (want vX.Y.Z or X.Y.Z)"
+          target="v${1#v}"
+          ;;
+        status)
+          [ -z "$version" ] || refuse "release status takes one version, got $version and $1"
+          is_semver "${1#v}" || refuse "not a version: $1 (want vX.Y.Z or X.Y.Z)"
+          version="${1#v}"
+          ;;
+        *)
+          refuse "release $verb takes no argument, got: $1"
+          ;;
+      esac
+      ;;
+  esac
+  shift
+done
+
+case "$verb" in
+  cut) [ -n "$target" ] || refuse "a cut needs a target: --patch, --minor, --major or vX.Y.Z" ;;
+  status) [ -n "$version" ] || refuse "release status needs a version" ;;
+esac
+
+# --- act ------------------------------------------------------------------
+
+cd "${PROJECT_ROOT:?}" || die "cannot enter $PROJECT_ROOT"
+
+# THE CONFIG CACHE DOES NOT CROSS INTO A HANDLER, and an empty cache would read
+# as "declared nothing" -- every key at its default, in a project that declared
+# otherwise. So a config that does not load stops the command.
+cfg_load "${DEVBIN_DIR:?}/config.yaml" || die "release: cannot read $DEVBIN_DIR/config.yaml"
+
+# check_declaration -- validate, then print every release key with its value
+# and whether the project declared it or it is the default.
+check_declaration() {
+  local key shape value from IFS=$' \t\n'
+  if ! cfg_validate; then
+    die "release check: $DEVBIN_DIR/config.yaml does not validate (above)"
+  fi
+  printf 'release: declaration (%s)\n' "$DEVBIN_DIR/config.yaml"
+  while read -r shape key _; do
+    [ -n "$shape" ] || continue
+    if cfg_has "release.$key" || [ -n "$(cfg_list "release.$key")" ]; then from=declared; else from=default; fi
+    if [ "$shape" = scalar ]; then
+      value="$(cfg_release_get "$key")"
+    else
+      value="$(cfg_release_list "$key")"
+      value="${value//$'\n'/, }"
+      if [ -z "$value" ] && [ "$key" = remotes ]; then
+        value="every remote git lists"
+      fi
+    fi
+    printf '  %-12s %-28s %s\n' "$key" "${value:-(none)}" "$from"
+  done <<<"$_DEVBIN_RELEASE_SCHEMA"
+  check_release_writers
+}
+
+# check_release_writers -- D42: one writer per release object. A tag-triggered
+# workflow that calls `gh release` races a local `gh release create`, and a
+# workflow that recreates its release discards the local one. Reported for the
+# project to decide, never guessed.
+check_release_writers() {
+  local wf
+  [ "$(cfg_release_get object)" = local ] || return 0
+  [ -d .github/workflows ] || return 0
+  for wf in .github/workflows/*.yml .github/workflows/*.yaml; do
+    [ -f "$wf" ] || continue
+    grep -qE '^[[:space:]]*tags:' "$wf" || continue
+    grep -qE 'gh release' "$wf" || continue
+    printf 'release: WARNING: %s runs gh release on a pushed tag, and object is local:\n' "$wf"
+    printf '         both would make the release object. Declare release.object: ci if the\n'
+    printf '         workflow makes it, or remove its gh release step.\n'
+  done
+  return 0
+}
+
+case "$verb" in
+  check)
+    check_declaration
+    printf 'release: the notes half is not built yet (ST0007 WP-02) -- the notes views were not examined\n'
+    ;;
+  notes)
+    not_yet "release notes" "ST0007 WP-02 (notes providers)"
+    ;;
+  status)
+    not_yet "release status" "ST0007 WP-03"
+    ;;
+  cut)
+    : "$dry_run" "$assume_yes"
+    not_yet "release $target" "ST0007 WP-04 to WP-06 (the sequence)"
+    ;;
+esac
