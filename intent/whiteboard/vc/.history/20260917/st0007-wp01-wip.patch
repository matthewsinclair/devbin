+#
+# EVERY VALUE SHOWN IS THE DEFAULT. A project that enables `release` and
+# declares no block releases with all of them, and a block names only what
+# differs (hv, 2026-09-16: every key has a default, and every default can be
+# overridden). A key the declared mode never reads is refused, not ignored:
+# `title` outside object: local, `object_wait` outside object: ci, `ci.wait`
+# without `ci.query`, `notes.run` outside notes.kind: command. Those are shown
+# commented out for that reason.
+#
+# A list is declared EMPTY as the single item "-": the grammar has no `[]`.
+release:
+  tag: "v{version}"          # must contain {version}. Utilz declares "{version}".
+  # remotes:                 # undeclared: every remote `git remote` lists, in that order
+  #   - origin
+  branch: main
+  notes:
+    kind: changelog          # changelog | releases | command
+    # run: bin/release-notes # notes.kind: command only -- receives the verb and the version
+  # derived:                 # commands that regenerate derived files, each printing the paths it wrote
+  #   - cargo update --workspace
+  gates:                     # devbin verbs, run in order on the release commit; each must exit 0
+    - check all
+    - test all
+  # ci:                      # undeclared: CI is not consulted
+  #   query: bin/ci-state    # prints green | failed | pending | none | unknown for a commit sha
+  #   wait: 20m              # how long the post-release verdict waits on pending or none
+  object: local              # local | ci | none -- who makes the release object
+  title: "{tag}"             # object: local only. {tag} and {version} expand.
+  # object_wait: 20m         # object: ci only -- how long to wait for the workflow's release object
+  # after:                   # commands run after the release object, reported, outside the core's guarantees
+  #   - bin/announce
