diff --git a/tests/unit/releasecore.bats b/tests/unit/releasecore.bats
new file mode 100644
index 0000000..5706702
--- /dev/null
+++ b/tests/unit/releasecore.bats
@@ -0,0 +1,467 @@
+#!/usr/bin/env bats
+# release.bats - the release core (ST0007)
+#
+# WP-01: the opt-in row, the `release:` schema and its defaults (D35, D37), the
+# declaration half of `release check`, and the argument loop (D36). Every
+# argument is parsed before anything acts, and `--help` anywhere never acts:
+# issue 0064 recorded `macos prepare --help` rebuilding Intent.app.
+
+load "../lib/test_helper"
+
+setup() {
+  devbin_setup
+  export PROJECT_ROOT="$DEVBIN_TEST_TMPDIR"
+  # shellcheck source=lib/helpers
+  . "$DEVBIN_LIB_DIR/helpers"
+  # shellcheck source=lib/config
+  . "$DEVBIN_LIB_DIR/config"
+  init_colors off
+}
+teardown() { devbin_teardown; }
+
+enabled_project() {
+  mkproj demo <<'YAML'
+project:
+  name: demo
+commands:
+  release:
+    enabled: true
+YAML
+}
+
+# git_project <proj> -- a committed repository with a bare remote holding main,
+# and a `gh` stub on PATH that records every call outside the project.
+git_project() {
+  local proj="$1"
+  git -C "$proj" init -q -b main
+  git -C "$proj" add -A
+  git -C "$proj" -c user.name=t -c user.email=t@t commit -qm init
+  git init -q --bare "$DEVBIN_TEST_TMPDIR/remote.git"
+  git -C "$proj" remote add origin "$DEVBIN_TEST_TMPDIR/remote.git"
+  git -C "$proj" push -q origin main
+  mkdir -p "$DEVBIN_TEST_TMPDIR/stubs"
+  printf '#!/bin/sh\necho "gh $*" >>"%s/gh.calls"\n' "$DEVBIN_TEST_TMPDIR" >"$DEVBIN_TEST_TMPDIR/stubs/gh"
+  chmod +x "$DEVBIN_TEST_TMPDIR/stubs/gh"
+}
+
+# fingerprint <proj> -- every file's bytes, every ref, the remote's refs, and
+# whether gh was ever called. Anything a release could write changes this.
+fingerprint() {
+  local proj="$1"
+  (
+    cd "$proj" &&
+      find . -path ./.git -prune -o -type f -print | LC_ALL=C sort | while IFS= read -r f; do
+        printf '%s %s\n' "$(cksum <"$f")" "$f"
+      done
+  )
+  git -C "$proj" for-each-ref
+  git -C "$proj" status --porcelain --ignored --untracked-files=all
+  git -C "$DEVBIN_TEST_TMPDIR/remote.git" for-each-ref
+  [ ! -e "$DEVBIN_TEST_TMPDIR/gh.calls" ] || cat "$DEVBIN_TEST_TMPDIR/gh.calls"
+}
+
+# ============================================================================
+# OPT-IN (D35, AC-1.2)
+# ============================================================================
+
+@test "release is absent, and refused as not enabled, in a project that has not asked for it" {
+  proj="$(mkproj demo <<'YAML'
+project:
+  name: demo
+YAML
+  )"
+  run devbin_run "$proj" help
+  assert_success
+  refute_output_matches '(^|'$'\n'')  release '
+  run devbin_run "$proj" release --help
+  assert_failure
+  assert_output_contains "devbin ships it"
+  assert_output_contains "commands.release.enabled: true"
+}
+
+@test "a release: block does not enable release by being present" {
+  proj="$(mkproj demo <<'YAML'
+project:
+  name: demo
+release:
+  object: none
+YAML
+  )"
+  run devbin_run "$proj" release --help
+  assert_failure
+  assert_output_contains "commands.release.enabled: true"
+}
+
+@test "enabled: true offers release, and runs devbin's handler" {
+  proj="$(enabled_project)"
+  run devbin_run "$proj" help
+  assert_success
+  assert_output_matches '(^|'$'\n'')  release '
+  run devbin_run "$proj" release --help
+  assert_success
+  assert_output_contains "usage:"
+}
+
+# ============================================================================
+# THE ARGUMENT LOOP (D36, AC-1.3)
+# ============================================================================
+
+@test "a bare release prints usage and exits 1" {
+  proj="$(enabled_project)"
+  run devbin_run "$proj" release
+  [ "$status" -eq 1 ]
+  assert_output_contains "usage:"
+}
+
+@test "--help or -h anywhere in any release invocation prints usage and changes no file, ref, remote or release object" {
+  proj="$(enabled_project)"
+  git_project "$proj"
+  before="$(fingerprint "$proj")"
+  local inv
+  while IFS= read -r inv; do
+    [ -n "$inv" ] || continue
+    # shellcheck disable=SC2086  # each line is an argument list
+    run env PATH="$DEVBIN_TEST_TMPDIR/stubs:$PATH" bash -c 'cd "$1" && shift && ./bin/devbin release "$@" </dev/null' _ "$proj" $inv
+    [ "$status" -eq 0 ] || {
+      echo "release $inv exited $status: $output" >&2
+      return 1
+    }
+    assert_output_contains "usage:"
+    [ "$(fingerprint "$proj")" = "$before" ] || {
+      echo "release $inv changed the repository, a remote or gh" >&2
+      return 1
+    }
+  done <<'EOF'
+--help
+-h
+--patch --help
+--minor -h
+--major --yes --help
+v1.2.3 --help
+1.2.3 -h
+--dry-run --patch --help
+--help --patch
+status v1.0.0 --help
+status --help
+notes -h
+check --help
+--bogus --help
+v1.2.3 v1.2.4 -h
+EOF
+}
+
+@test "--help is an argument, not a substring: a version is never read as a help flag" {
+  proj="$(enabled_project)"
+  run devbin_run "$proj" release status --helpful
+  [ "$status" -eq 1 ]
+  assert_output_contains "--helpful"
+}
+
+@test "every refusal in the argument loop exits 1 naming the argument, before anything runs" {
+  proj="$(enabled_project)"
+  git_project "$proj"
+  before="$(fingerprint "$proj")"
+  local line args want
+  while IFS='|' read -r args want; do
+    [ -n "$args" ] || continue
+    # shellcheck disable=SC2086
+    run env PATH="$DEVBIN_TEST_TMPDIR/stubs:$PATH" bash -c 'cd "$1" && shift && ./bin/devbin release "$@" </dev/null' _ "$proj" $args
+    [ "$status" -eq 1 ] || {
+      echo "release $args exited $status, want 1: $output" >&2
+      return 1
+    }
+    printf '%s' "$output" | grep -qF -- "$want" || {
+      echo "release $args did not name: $want -- got: $output" >&2
+      return 1
+    }
+  done <<'EOF'
+--bogus|--bogus
+--patch --minor|--minor
+--patch v1.2.3|v1.2.3
+v1.2|v1.2
+v1.2.3.4|v1.2.3.4
+status|status needs a version
+status v1.0|v1.0
+status v1.0.0 v1.0.1|v1.0.1
+status --patch|--patch
+check --patch|--patch
+notes v1.2.3|v1.2.3
+check notes|notes
+--dry-run|a target
+--yes|a target
+EOF
+  [ "$(fingerprint "$proj")" = "$before" ]
+}
+
+@test "a well-formed cut, status or notes invocation is parsed and says the step is not built yet, exiting 3 and writing nothing" {
+  proj="$(enabled_project)"
+  git_project "$proj"
+  before="$(fingerprint "$proj")"
+  local inv
+  for inv in "--patch" "v1.2.3" "--dry-run --major" "--yes 2.0.0" "status v1.0.0" "notes"; do
+    # shellcheck disable=SC2086
+    run env PATH="$DEVBIN_TEST_TMPDIR/stubs:$PATH" bash -c 'cd "$1" && shift && ./bin/devbin release "$@" </dev/null' _ "$proj" $inv
+    [ "$status" -eq 3 ] || {
+      echo "release $inv exited $status, want 3: $output" >&2
+      return 1
+    }
+    assert_output_contains "not built yet"
+  done
+  [ "$(fingerprint "$proj")" = "$before" ]
+}
+
+# ============================================================================
+# THE SCHEMA AND ITS DEFAULTS (D37, AC-1.1)
+# ============================================================================
+
+@test "devbin's own declaration (D43) validates" {
+  cfg_load_string <<'YAML'
+project:
+  name: devbin
+commands:
+  release:
+    enabled: true
+release:
+  notes:
+    kind: releases
+  gates:
+    - test all
+    - check all
+    - doctor
+  object: ci
+YAML
+  run cfg_validate
+  assert_success
+}
+
+@test "every D37 key validates at its documented default" {
+  cfg_load_string <<'YAML'
+project:
+  name: demo
+release:
+  tag: "v{version}"
+  remotes:
+    - origin
+  branch: main
+  notes:
+    kind: changelog
+  derived:
+    - cargo update --workspace
+  gates:
+    - check all
+    - test all
+  ci:
+    query: bin/ci-state
+    wait: 20m
+  object: local
+  title: "{tag}"
+  after:
+    - bin/announce
+YAML
+  run cfg_validate
+  assert_success
+}
+
+@test "with no release: block, every key reads its D37 default" {
+  cfg_load_string <<'YAML'
+project:
+  name: demo
+commands:
+  release:
+    enabled: true
+YAML
+  cfg_validate
+  [ "$(cfg_release_get tag)" = "v{version}" ]
+  [ "$(cfg_release_get branch)" = main ]
+  [ "$(cfg_release_get notes.kind)" = changelog ]
+  [ "$(cfg_release_get notes.run)" = "" ]
+  [ "$(cfg_release_get ci.query)" = "" ]
+  [ "$(cfg_release_get ci.wait)" = 20m ]
+  [ "$(cfg_release_get object)" = local ]
+  [ "$(cfg_release_get title)" = "{tag}" ]
+  [ "$(cfg_release_get object_wait)" = 20m ]
+  [ "$(cfg_release_list gates)" = "check all
+test all" ]
+  [ -z "$(cfg_release_list remotes)" ]
+  [ -z "$(cfg_release_list derived)" ]
+  [ -z "$(cfg_release_list after)" ]
+}
+
+@test "a declared key overrides its default, and a list declared as - is explicitly empty" {
+  cfg_load_string <<'YAML'
+project:
+  name: demo
+release:
+  tag: "{version}"
+  gates:
+    - "-"
+  remotes:
+    - upstream
+    - local
+YAML
+  cfg_validate
+  [ "$(cfg_release_get tag)" = "{version}" ]
+  [ -z "$(cfg_release_list gates)" ]
+  [ "$(cfg_release_list remotes)" = "upstream
+local" ]
+}
+
+@test "the schema reads the same under a strict-mode IFS" {
+  # Lesson (p) of 2026-09-16: a table split with read takes on the caller's IFS.
+  cfg_load_string <<'YAML'
+project:
+  name: demo
+release:
+  object: none
+  gates:
+    - test all
+YAML
+  local IFS=$'\n\t'
+  cfg_validate
+  [ "$(cfg_release_get tag)" = "v{version}" ]
+  [ "$(cfg_release_get object)" = none ]
+  [ "$(cfg_release_list gates)" = "test all" ]
+}
+
+@test "the reader refuses a key the release schema does not have, and a list read as a scalar" {
+  cfg_load_string <<'YAML'
+project:
+  name: demo
+YAML
+  run cfg_release_get bump
+  assert_failure
+  assert_output_contains "bump"
+  run cfg_release_get gates
+  assert_failure
+  run cfg_release_list tag
+  assert_failure
+}
+
+@test "every value refusal in the release schema names the key and the reason" {
+  local block want
+  while IFS='|' read -r block want; do
+    [ -n "$block" ] || continue
+    cfg_load_string <<YAML
+project:
+  name: demo
+release:
+$(printf '%b' "$block")
+YAML
+    run cfg_validate
+    [ "$status" -ne 0 ] || {
+      echo "accepted: $block" >&2
+      return 1
+    }
+    printf '%s' "$output" | grep -qF -- "$want" || {
+      echo "for $block, want: $want -- got: $output" >&2
+      return 1
+    }
+  done <<'EOF'
+  bump: patch|unknown key: release.bump
+  notes:\n    path: CHANGELOG.md|unknown key: release.notes.path
+  tag: release-1|release.tag
+  branch: ""|release.branch
+  notes:\n    kind: markdown|release.notes.kind
+  notes:\n    kind: command|release.notes.run
+  notes:\n    run: bin/notes|release.notes.run
+  object: github|release.object
+  object: ci\n  title: devbin {version}|release.title
+  object_wait: 5m|release.object_wait
+  object: ci\n  object_wait: soon|release.object_wait
+  ci:\n    query: bin/ci\n    wait: 20 minutes|release.ci.wait
+  ci:\n    wait: 10m|release.ci.wait
+  ci:\n    query: ""|release.ci.query
+  gates:\n    - ""|release.gates.0
+  gates:\n    - "-"\n    - test all|release.gates
+  after:\n    - ""|release.after.0
+  gates:\n    first: check all|unknown key: release.gates.first
+  tag:\n    0: x|unknown key: release.tag.0
+EOF
+}
+
+@test "the reference config's release block shows every key at the default the reader uses" {
+  # Keys the default mode never reads are shown commented out, since declaring
+  # them is refused, so each value is read from the block's text either way.
+  cfg_load "$DEVBIN_LIB_DIR/config.reference.yaml"
+  cfg_validate
+  local block key leaf v n=0
+  block="$(awk '/^release:/ { f = 1; next } f && /^[a-z]/ { exit } f' "$DEVBIN_LIB_DIR/config.reference.yaml")"
+  for key in tag branch notes.kind ci.wait object title object_wait; do
+    leaf="${key##*.}"
+    v="$(printf '%s\n' "$block" | sed -nE "s/^ *#? *${leaf}: *\"?([^\" ]*)\"?( .*)?$/\\1/p" | sed -n 1p)"
+    [ -n "$v" ] || {
+      echo "lib/config.reference.yaml does not show release.$key" >&2
+      return 1
+    }
+    [ "$v" = "$(_cfg_release_default "$key")" ] || {
+      echo "release.$key: reference shows $v, the reader defaults to $(_cfg_release_default "$key")" >&2
+      return 1
+    }
+    n=$((n + 1))
+  done
+  [ "$n" -eq 7 ]
+  [ "$(cfg_release_list gates)" = "$(_cfg_release_default gates | tr '|' '\n')" ]
+  [ -n "$(cfg_list release.gates)" ]
+}
+
+# ============================================================================
+# release check -- THE DECLARATION HALF (D36)
+# ============================================================================
+
+@test "release check prints every key with its value and whether it is declared or the default, and says the notes half is not built" {
+  proj="$(mkproj demo <<'YAML'
+project:
+  name: demo
+commands:
+  release:
+    enabled: true
+release:
+  object: none
+YAML
+  )"
+  run devbin_run "$proj" release check
+  assert_success
+  assert_output_matches 'object +none +declared'
+  assert_output_matches 'tag +v\{version\} +default'
+  assert_output_matches 'gates +check all, test all +default'
+  assert_output_matches 'remotes +every remote git lists +default'
+  assert_output_contains "notes half is not built yet"
+}
+
+@test "release check fails on a malformed release: block, naming the key" {
+  proj="$(mkproj demo <<'YAML'
+project:
+  name: demo
+commands:
+  release:
+    enabled: true
+release:
+  object: github
+YAML
+  )"
+  run devbin_run "$proj" release check
+  [ "$status" -eq 1 ]
+  assert_output_contains "release.object"
+}
+
+@test "release check warns when a tag-triggered workflow calls gh release and object is local, and not under object: ci" {
+  proj="$(enabled_project)"
+  mkdir -p "$proj/.github/workflows"
+  cat >"$proj/.github/workflows/release.yml" <<'YML'
+on:
+  push:
+    tags: ["v*"]
+jobs:
+  release:
+    steps:
+      - run: gh release create "$GITHUB_REF_NAME"
+YML
+  run devbin_run "$proj" release check
+  assert_success
+  assert_output_contains "WARNING"
+  assert_output_contains ".github/workflows/release.yml"
+  printf 'release:\n  object: ci\n' >>"$proj/bin/.devbin/config.yaml"
+  run devbin_run "$proj" release check
+  assert_success
+  refute_output_contains "WARNING"
+}
