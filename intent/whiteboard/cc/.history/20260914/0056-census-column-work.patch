-# scan -- one TAB-separated record per install: kind, path, version, commit, digest, utc
+# _estate_git <args...> -- git, asked about somebody else's repository.
+#
+# `--no-optional-locks` because a plain `git status` may refresh the index and
+# take its lock: a census could fail a peer's concurrent commit with
+# `index.lock exists`, and leave a write in a repository it only meant to read.
+# GIT_DIR and friends are dropped because a value inherited from the caller
+# would point every estate's question at ONE repository and answer it
+# confidently for all of them.
+_estate_git() {
+  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git --no-optional-locks "$@"
+}
+
+# seam_committed <root> -- is this install's vendored seam COMMITTED in its own
+# repository? One of: committed, DIRTY, not a checkout, not its own checkout,
+# not tracked, UNREADABLE.
+#
+# THE CENSUS READ DISK AND NEVER ASKED GIT (issue 0056). Every other column
+# answers "what bytes are on this machine"; readers used them to answer "what
+# is the fleet running", and those diverge the moment a re-vendor is not
+# committed. Three estates were in that state the day 0056 was filed and the
+# census reported none of them. A fourth, Gtools-geodica, sat from 2026-09-11
+# to 2026-09-14 with only its manifest's source_commit moved (per gtools-vc).
+#
+# IT REPORTS AND NEVER JUDGES. Whether a dirty seam is a problem is context this
+# tool does not have -- Intentv2 is dirty by ruling and frozen -- so nothing
+# refuses on it, and `doc` publishes a DIRTY estate like any other.
+#
+# ABSENT MUST NEVER READ AS CLEAN, which is why most of the answers exist. `git
+# status` prints NOTHING both for a committed seam and for a path it is not
+# watching, so an empty status means `committed` only once two more things hold:
+# the install is the ROOT of its own repository -- a deps/ checkout inside a host
+# that ignores deps/ would otherwise read clean -- and that repository TRACKS the
+# seam at all, since one that ignores bin/ would too.
+#
+# THE PATHSPEC IS THE SEAM'S DIRECTORIES, never names found on disk: git reads a
+# directory against HEAD, so a vendored file deleted and not committed still
+# shows (usage-rules.md, The seam).
+seam_committed() {
+  local root="$1" top here out
+  if ! top="$(_estate_git -C "$root" rev-parse --show-toplevel 2>/dev/null)"; then
+    printf 'not a checkout'
+    return 0
+  fi
+  if ! here="$(cd "$root" && pwd -P)" || ! top="$(cd "$top" && pwd -P)"; then
+    printf 'UNREADABLE'
+    return 0
+  fi
+  if [ "$top" != "$here" ]; then
+    printf 'not its own checkout'
+    return 0
+  fi
+  if ! out="$(_estate_git -C "$root" status --porcelain -- \
+    bin/devbin bin/.devbin/lib bin/.devbin/manifest.sha256 2>/dev/null)"; then
+    printf 'UNREADABLE'
+    return 0
+  fi
+  if [ -n "$out" ]; then
+    printf 'DIRTY'
+    return 0
+  fi
+  if ! _estate_git -C "$root" ls-files --error-unmatch -- bin/.devbin/manifest.sha256 >/dev/null 2>&1; then
+    printf 'not tracked'
+    return 0
+  fi
+  printf 'committed'
+  return 0
+}
+
+# scan -- one TAB-separated record per install: kind, path, version, commit,
+# digest, utc, committed
 scan() {
   local m root ver sc dg e
   while IFS= read -r m; do
@@ -252,9 +321,9 @@ scan() {
     esac
     dg="$(seam_digest "$root")"
     e="$(mtime_epoch "$m")"
-    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
+    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
       "$(kind_of "$root")" "${root#"$HOME"/}" "$ver" "$sc" "$dg" \
-      "$(utc_from_epoch "$e" || printf 'UNREADABLE')"
+      "$(utc_from_epoch "$e" || printf 'UNREADABLE')" "$(seam_committed "$root")"
   done < <(find_installs)
 }
 
