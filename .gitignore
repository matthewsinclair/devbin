# macOS
.DS_Store

# Editor / tooling scratch
*.swp
*~
.idea/
.vscode/

# Test + run artefacts
tmp/
tests/tmp/

# Intent generated views (regenerate with `intent todo update`)
intent/todo.md

# Per-developer Claude Code settings (paths and tool allowlists vary).
.claude/settings.local.json

# AGENTS.md regeneration safety net (intent agents sync writes this; transient).
/AGENTS.md.bak



# Intent upgrade backups (machine-local, regenerated by `intent upgrade`).
.backup/

# The Intent runtime store: per-machine, rebuilt from the committed extract.
intent/.cache/

# D53: the event log lives in the store; its file form is produced by `intent export`.
intent/.backup/
